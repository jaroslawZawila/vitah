{
  "name": "mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "setupFiles": [
      "./test-utils/setup.ts"
    ],
    "setupFilesAfterEnv": [
      "./test-utils/setup-after-env.ts"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-vector-icons/feather": "^13.1.4",
    "@repo/brand-tokens": "workspace:*",
    "@repo/core": "workspace:*",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
