{
  "expo": {
    "name": "ViTAH",
    "slug": "vitah-app",
    "scheme": "vitah",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vitah.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e1e1e"
      },
      "package": "app.vitah"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ViTAH usa Face ID para proteger el acceso a tu proyecto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
