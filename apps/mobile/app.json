{
  "expo": {
    "name": "ViTAH",
    "slug": "vitah-app",
    "scheme": "vitah",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vitah.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e1e1e"
      },
      "package": "app.vitah",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ViTAH usa Face ID para proteger el acceso a tu proyecto."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19436f4d-bc1c-4362-a4ad-c48623fbbfe4"
      }
    },
    "owner": "jaroslaw.zawila"
  }
}
