{
  "expo": {
    "name": "ViTAH",
    "slug": "vitah-app",
    "scheme": "vitah",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "vitah.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1e1e"
      },
      "package": "app.vitah",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ViTAH usa Face ID para proteger el acceso a tu proyecto."
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "ViTAH usa tus fotos para adjuntarlas a una solicitud de garantía.",
          "cameraPermission": "ViTAH usa la cámara para fotografiar lo que quieres que revisemos en garantía.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/19436f4d-bc1c-4362-a4ad-c48623fbbfe4"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19436f4d-bc1c-4362-a4ad-c48623fbbfe4"
      }
    },
    "owner": "jaroslaw.zawila"
  }
}
