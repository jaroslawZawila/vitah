{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/commit-gate.sh",
            "timeout": 600,
            "statusMessage": "Running tests, type checks and lint before commit..."
          }
        ]
      }
    ]
  }
}
